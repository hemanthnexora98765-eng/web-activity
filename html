<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hemanth Venkat | Portfolio</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <header>
        <nav class="navbar">
            <h2 class="logo">Hemanth<span>.</span></h2>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#skills">Skills</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#achievements">Achievements</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Home Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <p class="welcome">WELCOME TO MY PORTFOLIO</p>

            <h1>Hi, I'm <span>Hemanth Venkat</span></h1>

            <h2>Student | Developer | AI Enthusiast</h2>

            <p class="intro">
                I am a student passionate about technology, programming,
                creativity, and building projects that turn ideas into reality.
            </p>

            <div class="hero-buttons">
                <a href="#projects" class="btn primary-btn">Explore My Projects</a>
                <a href="#contact" class="btn secondary-btn">Contact Me</a>
            </div>
        </div>

        <div class="hero-image">
            <img src="images/profile.jpg" alt="My Profile Photo">
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section">
        <h2 class="section-title">About <span>Me</span></h2>

        <div class="about-card">
            <p>
                Hello! I'm Hemanth Venkat, a college student interested in
                technology, artificial intelligence, and software development.
                I enjoy exploring new ideas, learning programming, and
                creating digital projects. My goal is to continuously
                improve my skills and build useful solutions through technology.
            </p>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="section">
        <h2 class="section-title">My <span>Skills</span></h2>

        <div class="skills-container">
            <div class="skill-card">HTML</div>
            <div class="skill-card">CSS</div>
            <div class="skill-card">JavaScript</div>
            <div class="skill-card">Python</div>
            <div class="skill-card">AI Tools</div>
            <div class="skill-card">Problem Solving</div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="section">
        <h2 class="section-title">My <span>Projects</span></h2>

        <div class="projects-container">

            <div class="project-card">
                <h3>HemuAI</h3>
                <p>
                    A personal AI assistant project designed to provide
                    intelligent conversations and helpful assistance.
                </p>
                <span class="tag">AI</span>
                <span class="tag">Python / AI</span>
            </div>

            <div class="project-card">
                <h3>Personal Portfolio</h3>
                <p>
                    A responsive website that introduces me, displays
                    my skills, and showcases my projects.
                </p>
                <span class="tag">HTML</span>
                <span class="tag">CSS</span>
            </div>

            <div class="project-card">
                <h3>Mini Projects</h3>
                <p>
                    A collection of small projects created while learning
                    programming and web development.
                </p>
                <span class="tag">Programming</span>
                <span class="tag">Learning</span>
            </div>

        </div>
    </section>

    <!-- Achievements Section -->
    <section id="achievements" class="section">
        <h2 class="section-title">My <span>Achievements</span></h2>

        <div class="about-card">
            <p>
                This section will showcase my certificates, hackathon
                participation, awards, academic accomplishments, and
                milestones as I continue my learning journey.
            </p>
        </div>
    </section>

    <!-- Education Section -->
    <section id="education" class="section">
        <h2 class="section-title">My <span>Education</span></h2>

        <div class="project-card education-card">
            <h3>B.Tech Student</h3>
            <p>National Institute of Advanced Technology (NIAT)</p>
            <p>Undergraduate Student</p>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="section">
        <h2 class="section-title">Contact <span>Me</span></h2>

        <div class="contact-card">
            <p>Interested in connecting or collaborating on a project?</p>

            <a href="mailto:your-email@example.com" class="btn primary-btn">
                Send Me an Email
            </a>

            <div class="social-links">
                <a href="https://github.com/" target="_blank">GitHub</a>
                <a href="https://linkedin.com/" target="_blank">LinkedIn</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Hemanth Venkat | Personal Portfolio</p>
        <p>Designed and built with HTML & CSS</p>
    </footer>

</body>
</html>
