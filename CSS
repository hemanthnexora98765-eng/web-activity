@import url('https://fonts.googleapis.com/css2?family=Bree+Serif&family=Caveat:wght@400;700&family=Lobster&family=Monoton&family=Open+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Playfair+Display+SC:ital,wght@0,400;0,700;1,700&family=Playfair+Display:ital,wght@0,400;0,700;1,700&family=Roboto:ital,wght@0,400;0,700;1,400;1,700&family=Source+Sans+Pro:ital,wght@0,400;0,700;1,700&family=Work+Sans:ital,wght@0,400;0,700;1,700&display=swap');
/* ===== GENERAL SETTINGS ===== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #080b16;
    color: #ffffff;
}

/* ===== NAVIGATION ===== */

header {
    background-color: #0d1222;
    border-bottom: 1px solid #1e293b;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 20px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 26px;
    color: white;
}

.logo span {
    color: #38bdf8;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 25px;
}

.nav-links a {
    text-decoration: none;
    color: #cbd5e1;
    font-size: 14px;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #38bdf8;
}

/* ===== HOME SECTION ===== */

.hero {
    min-height: 90vh;
    max-width: 1200px;
    margin: auto;
    padding: 70px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
}

.hero-content {
    max-width: 650px;
}

.welcome {
    color: #38bdf8;
    letter-spacing: 4px;
    font-size: 13px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 15px;
}

.hero h1 span {
    color: #38bdf8;
}

.hero h2 {
    font-size: 22px;
    color: #a78bfa;
    margin-bottom: 20px;
}

.intro {
    color: #a8b3c7;
    font-size: 17px;
    line-height: 1.8;
}

/* ===== BUTTONS ===== */

.hero-buttons {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.btn {
    display: inline-block;
    padding: 13px 22px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.primary-btn {
    background-color: #38bdf8;
    color: #08111f;
}

.primary-btn:hover {
    background-color: #7dd3fc;
    transform: translateY(-3px);
}

.secondary-btn {
    border: 1px solid #38bdf8;
    color: #38bdf8;
}

.secondary-btn:hover {
    background-color: #38bdf8;
    color: #08111f;
}

/* ===== PROFILE IMAGE ===== */

.hero-image img {
    width: 300px;
    height: 300px;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid #38bdf8;
    box-shadow: 0 0 35px rgba(56, 189, 248, 0.2);
}

/* ===== GENERAL SECTIONS ===== */

.section {
    padding: 80px 30px;
    max-width: 1200px;
    margin: auto;
}

.section-title {
    text-align: center;
    font-size: 36px;
    margin-bottom: 45px;
}

.section-title span {
    color: #38bdf8;
}

/* ===== ABOUT ===== */

.about-card {
    background-color: #111827;
    border: 1px solid #253249;
    border-radius: 15px;
    padding: 35px;
    color: #b8c4d8;
    font-size: 17px;
    line-height: 1.9;
}

/* ===== SKILLS ===== */

.skills-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.skill-card {
    background-color: #111827;
    border: 1px solid #253249;
    padding: 25px;
    border-radius: 12px;
    text-align: center;
    font-size: 18px;
    transition: 0.3s;
}

.skill-card:hover {
    border-color: #38bdf8;
    transform: translateY(-5px);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.1);
}

/* ===== PROJECTS ===== */

.projects-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.project-card {
    background-color: #111827;
    border: 1px solid #253249;
    border-radius: 15px;
    padding: 30px;
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-7px);
    border-color: #818cf8;
}

.project-card h3 {
    color: #38bdf8;
    font-size: 22px;
    margin-bottom: 15px;
}

.project-card p {
    color: #a8b3c7;
    line-height: 1.7;
    margin-bottom: 20px;
}

.tag {
    display: inline-block;
    padding: 6px 12px;
    background-color: #1e293b;
    color: #a78bfa;
    border-radius: 20px;
    font-size: 12px;
    margin: 4px;
}

/* ===== EDUCATION ===== */

.education-card {
    max-width: 600px;
    margin: auto;
    text-align: center;
}

/* ===== CONTACT ===== */

.contact-card {
    text-align: center;
    background-color: #111827;
    border: 1px solid #253249;
    border-radius: 15px;
    padding: 40px;
}

.contact-card p {
    color: #a8b3c7;
    font-size: 17px;
    margin-bottom: 25px;
}

.social-links {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 25px;
}

.social-links a {
    color: #38bdf8;
    text-decoration: none;
}

.social-links a:hover {
    color: #a78bfa;
}

/* ===== FOOTER ===== */

footer {
    text-align: center;
    padding: 25px;
    background-color: #0d1222;
    border-top: 1px solid #1e293b;
    color: #8391a8;
    font-size: 14px;
    line-height: 2;
}

/* ===== RESPONSIVE DESIGN ===== */

@media (max-width: 900px) {

    .hero {
        flex-direction: column-reverse;
        text-align: center;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-image img {
        width: 230px;
        height: 230px;
    }

    .projects-container {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {

    .navbar {
        flex-direction: column;
        gap: 20px;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .hero h1 {
        font-size: 34px;
    }

    .hero h2 {
        font-size: 18px;
    }

    .intro {
        font-size: 15px;
    }

    .section-title {
        font-size: 29px;
    }

    .skills-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .projects-container {
        grid-template-columns: 1fr;
    }

    .section {
        padding: 60px 20px;
    }

    .hero {
        padding: 50px 20px;
    }

    .about-card,
    .project-card,
    .contact-card {
        padding: 25px;
    }
}
